# Local preview. Never put signing keys in NEXT_PUBLIC_* variables.
NODE_ENV=development
FYX_MODE=demo
PUBLIC_ORIGIN=http://localhost:3000
PORT=3001
API_URL=http://127.0.0.1:3001
# For Compose use a URL-encoded password matching POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
# Server-only Postgres URI. Supabase: Connect -> Session pooler (port 5432).
# Put the actual URI in root .env.local; percent-encode password characters.
DATABASE_URL=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
FYX_VAULT_ADDRESS=0xF15Dbc53de06Aaec3de35E4991F67343c7a87F13
VERIFIER_PRIVATE_KEY=
SPONSOR_ADDRESSES=
VERIFIER_ADDRESSES=
ADMIN_ADDRESSES=
