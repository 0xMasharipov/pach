# Load locally into your shell; never commit actual secrets.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Encrypted Foundry keystore account name. Import via cast wallet import --interactive.
FYX_DEPLOYER_ACCOUNT=
# Alternatively use a project-local encrypted keystore and password file.
FYX_DEPLOYER_KEYSTORE=
FYX_KEYSTORE_PASSWORD_FILE=
FYX_VERIFIER_ADDRESS=
FYX_TREASURY_ADDRESS=
# Optional cached native Solidity 0.8.33 binary for baseline checks.
SOLC_PATH=
